cat > .gitignore <<'EOF'
# -------------------------
# Python
# -------------------------
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/

# -------------------------
# Virtual environments
# -------------------------
.venv/
venv/
env/

# -------------------------
# Secrets / environment
# -------------------------
.env
.env.*
!.env.example

# -------------------------
# SQLite / local user data
# -------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
fitness_backup_*.db

# -------------------------
# Streamlit local config
# -------------------------
.streamlit/secrets.toml

# -------------------------
# IDE / OS
# -------------------------
.DS_Store
.vscode/
.idea/

# -------------------------
# Temporary / generated
# -------------------------
*.log
*.tmp
.cache/
backups/
EOF