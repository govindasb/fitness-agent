{
  "version": 1,
  "description": "Hand-authored extraction expectations. Live execution is explicit and paid.",
  "cases": [
    {
      "id": "body_weight_only",
      "raw_text": "My weight is 96.2 kg.",
      "reference": "2026-07-08T15:30:00-04:00",
      "tags": ["body"],
      "notes": "No event time was stated.",
      "expected": {
        "parsed_input": {"body_metrics": [{"weight_kg": 96.2}]},
        "null_required": ["body_metrics[0].measured_at"]
      }
    },
    {
      "id": "body_weight_today",
      "raw_text": "Today I weighed 96.0 kg.",
      "reference": "2026-07-08T15:30:00-04:00",
      "tags": ["body", "relative_time"],
      "notes": "Today resolves to the fixed reference instant.",
      "expected": {"parsed_input": {"body_metrics": [{"weight_kg": 96.0, "measured_at": "2026-07-08T19:30:00+00:00"}]}}
    },
    {
      "id": "body_weight_morning",
      "raw_text": "I weighed 95.8 kg this morning.",
      "reference": "2026-07-08T15:30:00-04:00",
      "tags": ["body", "relative_time"],
